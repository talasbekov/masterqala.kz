# Базовый URL API, доступный серверу Next.js во время SSR/build (не браузеру).
# На проде указывает на внутренний адрес apps/api.
API_URL="http://localhost:3000/api/v1"

# Адрес клиентского приложения (apps/client), на который сайт ссылается
# из карточек "Оставить заявку" и подобных CTA.
APP_URL="http://localhost:5173"

# Канонический адрес самого сайта — база для metadataBase, sitemap и robots.
SITE_URL="https://masterqala.kz"

# Реальные контакты поддержки, отображаются в футере и в JSON-LD structured
# data для поисковиков. Без этих переменных на сайте виден служебный
# плейсхолдер вида "(заменить на реальный номер оператора перед запуском)" —
# см. apps/site/lib/env.ts. Обязательны перед боевым запуском.
CONTACT_PHONE="+7 700 000 00 00"
CONTACT_EMAIL="support@masterqala.kz"
