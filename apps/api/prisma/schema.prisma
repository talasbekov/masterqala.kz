generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  phone                  String                  @unique
  name                   String?
  defaultAddress         String?
  role                   UserRole                @default(CLIENT)
  createdAt              DateTime                @default(now())
  blockedAt              DateTime?
  blockedReason          String?
  isBlocked              Boolean                 @default(false)
  accruals               Accrual[]
  addresses              Address[]
  auditLogs              AuditLog[]
  disputesOpened         Dispute[]               @relation("DisputesOpened")
  disputesResolved       Dispute[]               @relation("DisputesResolved")
  leadCreditAccount      LeadCreditAccount?
  leadCreditPurchases    LeadCreditPurchase[]
  leadCreditTransactions LeadCreditTransaction[]
  cancellations          MasterCancellation[]
  presence               MasterPresence?
  masterProfile          MasterProfile?
  masterWalletAccount    MasterWalletAccount?
  clientOrders           Order[]                 @relation("ClientOrders")
  masterOrders           Order[]                 @relation("MasterOrders")
  offers                 OrderOffer[]
  pendingUploads         PendingUpload[]
  clientPlannedOrders    PlannedOrder[]          @relation("ClientPlannedOrders")
  masterPlannedOrders    PlannedOrder[]          @relation("MasterPlannedOrders")
  plannedOrderBids       PlannedOrderBid[]
  reviewsGiven           Review[]                @relation("ReviewsGiven")
  reviewsReceived        Review[]                @relation("ReviewsReceived")
  decisions              VerificationDecision[]
  withdrawalRequests     WithdrawalRequest[]
}

model PendingUpload {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  path       String    @unique
  mimeType   String
  sizeBytes  Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt, consumedAt])
}

model SmsCode {
  id        String    @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model Category {
  id            String           @id @default(uuid())
  slug          String           @unique
  name          String
  masters       MasterCategory[]
  orders        Order[]
  plannedOrders PlannedOrder[]
}

model MasterProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  fullName             String
  iin                  String
  district             String
  experienceYears      Int
  status               MasterStatus           @default(PENDING_REVIEW)
  rejectionReason      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  priorityPenaltyUntil DateTime?
  blockedUntil         DateTime?
  categories           MasterCategory[]
  documents            MasterDocument[]
  user                 User                   @relation(fields: [userId], references: [id])
  decisions            VerificationDecision[]
}

model MasterCategory {
  masterProfileId String
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)

  @@id([masterProfileId, categoryId])
}

model MasterDocument {
  id              String        @id @default(uuid())
  masterProfileId String
  type            DocumentType
  filePath        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime      @default(now())
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
}

model VerificationDecision {
  id              String        @id @default(uuid())
  masterProfileId String
  operatorId      String
  decision        DecisionType
  comment         String?
  createdAt       DateTime      @default(now())
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  operator        User          @relation(fields: [operatorId], references: [id])
}

model Order {
  id              String                    @id @default(uuid())
  clientId        String
  categoryId      String
  description     String
  address         String
  location        Unsupported("geography(Point, 4326)")?
  lat             Float?
  lng             Float?
  status          OrderStatus               @default(CREATED)
  commercialMode  CommercialMode            @default(PAID_MOCK)
  masterId        String?
  wave            Int                       @default(0)
  searchAttempt   Int                       @default(1)
  calloutPrice    Int
  serviceFee      Int
  workPrice       Int?
  workComment     String?
  cancelReason    String?
  acceptedAt      DateTime?
  onSiteAt        DateTime?
  priceProposedAt DateTime?
  completedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  addressComment  String?
  apartment       String?
  district        String
  entrance        String?
  floor           String?
  accruals        Accrual[]
  disputes        Dispute[]
  category        Category                  @relation(fields: [categoryId], references: [id])
  client          User                      @relation("ClientOrders", fields: [clientId], references: [id])
  master          User?                     @relation("MasterOrders", fields: [masterId], references: [id])
  offers          OrderOffer[]
  photos          OrderPhoto[]
  payments        PaymentTransaction[]
  review          Review?

  @@index([clientId, status])
  @@index([masterId, status])
  @@index([commercialMode, createdAt])
}

model OrderOffer {
  id           String       @id @default(uuid())
  orderId      String
  masterUserId String
  wave         Int
  attempt      Int
  sentAt       DateTime     @default(now())
  respondedAt  DateTime?
  outcome      OfferOutcome @default(PENDING)
  master       User         @relation(fields: [masterUserId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, masterUserId, attempt])
  @@index([masterUserId, outcome])
}

model MasterPresence {
  masterUserId String                    @id
  isOnline     Boolean                   @default(false)
  lastSeenAt   DateTime                  @default(now())
  location     Unsupported("geography(Point, 4326)")?
  user         User                      @relation(fields: [masterUserId], references: [id])
}

model PaymentTransaction {
  id          String        @id @default(uuid())
  orderId     String
  type        PaymentType
  amount      Int
  status      PaymentStatus
  providerRef String
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model Accrual {
  id           String      @id @default(uuid())
  masterUserId String
  orderId      String      @unique
  type         AccrualType
  amount       Int
  createdAt    DateTime    @default(now())
  master       User        @relation(fields: [masterUserId], references: [id])
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PlannedOrder {
  id             String              @id @default(uuid())
  clientId       String
  categoryId     String
  description    String
  address        String
  district       String
  status         PlannedOrderStatus  @default(CREATED)
  commercialMode CommercialMode      @default(PAID_MOCK)
  masterId       String?
  selectedBidId  String?             @unique
  workPrice      Int?
  cancelReason   String?
  publishedAt    DateTime?
  selectedAt     DateTime?
  confirmedAt    DateTime?
  completedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  addressComment String?
  apartment      String?
  budget         Int?
  entrance       String?
  floor          String?
  slotEnd        DateTime
  slotStart      DateTime
  disputes       Dispute[]
  category       Category            @relation(fields: [categoryId], references: [id])
  client         User                @relation("ClientPlannedOrders", fields: [clientId], references: [id])
  master         User?               @relation("MasterPlannedOrders", fields: [masterId], references: [id])
  selectedBid    PlannedOrderBid?    @relation("SelectedBid", fields: [selectedBidId], references: [id])
  bids           PlannedOrderBid[]   @relation("OrderBids")
  photos         PlannedOrderPhoto[]
  review         Review?

  @@index([clientId, status])
  @@index([masterId, status])
  @@index([categoryId, status])
  @@index([commercialMode, createdAt])
}

model PlannedOrderBid {
  id             String        @id @default(uuid())
  plannedOrderId String
  masterUserId   String
  price          Int
  term           String
  comment        String?
  createdAt      DateTime      @default(now())
  selectedFor    PlannedOrder? @relation("SelectedBid")
  master         User          @relation(fields: [masterUserId], references: [id])
  order          PlannedOrder  @relation("OrderBids", fields: [plannedOrderId], references: [id], onDelete: Cascade)

  @@unique([plannedOrderId, masterUserId])
  @@index([plannedOrderId])
}

model OrderPhoto {
  id        String   @id @default(uuid())
  orderId   String
  path      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PlannedOrderPhoto {
  id             String       @id @default(uuid())
  plannedOrderId String
  path           String
  createdAt      DateTime     @default(now())
  plannedOrder   PlannedOrder @relation(fields: [plannedOrderId], references: [id], onDelete: Cascade)

  @@index([plannedOrderId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  address   String
  entrance  String?
  floor     String?
  apartment String?
  comment   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeadCreditAccount {
  masterUserId String @id
  balance      Int    @default(0)
  master       User   @relation(fields: [masterUserId], references: [id])
}

model LeadCreditTransaction {
  id           String           @id @default(uuid())
  masterUserId String
  type         LeadCreditTxType
  amount       Int
  bidId        String?
  purchaseId   String?
  createdAt    DateTime         @default(now())
  master       User             @relation(fields: [masterUserId], references: [id])

  @@index([masterUserId, createdAt])
}

model LeadCreditPurchase {
  id           String        @id @default(uuid())
  masterUserId String
  credits      Int
  priceTenge   Int
  status       PaymentStatus
  providerRef  String
  createdAt    DateTime      @default(now())
  master       User          @relation(fields: [masterUserId], references: [id])
}

model MasterWalletAccount {
  masterUserId String @id
  balance      Int    @default(0)
  master       User   @relation(fields: [masterUserId], references: [id])
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  masterUserId String
  amount       Int
  status       WithdrawalStatus @default(PENDING)
  providerRef  String?
  requestedAt  DateTime         @default(now())
  paidAt       DateTime?
  master       User             @relation(fields: [masterUserId], references: [id])
}

model Dispute {
  id               String            @id @default(uuid())
  orderId          String?
  plannedOrderId   String?
  openedByUserId   String
  openedByRole     DisputeTargetRole
  reason           String
  evidenceDocIds   String[]          @default([])
  counterStatement String?
  status           DisputeStatus     @default(OPEN)
  refundServiceFee Boolean?
  penalizeMaster   Boolean?
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  openedByUser     User              @relation("DisputesOpened", fields: [openedByUserId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  plannedOrder     PlannedOrder?     @relation(fields: [plannedOrderId], references: [id])
  resolvedByUser   User?             @relation("DisputesResolved", fields: [resolvedByUserId], references: [id])

  @@index([orderId])
  @@index([plannedOrderId])
  @@index([status])
}

model Review {
  id             String        @id @default(uuid())
  orderId        String?       @unique
  plannedOrderId String?       @unique
  clientId       String
  masterUserId   String
  rating         Int
  comment        String?
  createdAt      DateTime      @default(now())
  client         User          @relation("ReviewsGiven", fields: [clientId], references: [id])
  master         User          @relation("ReviewsReceived", fields: [masterUserId], references: [id])
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plannedOrder   PlannedOrder? @relation(fields: [plannedOrderId], references: [id], onDelete: Cascade)

  @@index([masterUserId])
}

model MasterCancellation {
  id           String             @id @default(uuid())
  masterUserId String
  orderType    CancelledOrderType
  orderId      String
  createdAt    DateTime           @default(now())
  master       User               @relation(fields: [masterUserId], references: [id])

  @@index([masterUserId, createdAt])
}

model AuditLog {
  id         String          @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType AuditTargetType
  targetId   String
  comment    String?
  createdAt  DateTime        @default(now())
  actor      User?           @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

enum UserRole {
  CLIENT
  OPERATOR
}

enum MasterStatus {
  PENDING_REVIEW
  NEEDS_INFO
  ACTIVE
  REJECTED
}

enum DocumentType {
  ID_CARD
  QUALIFICATION
}

enum DecisionType {
  APPROVE
  REJECT
  REQUEST_INFO
}

enum CommercialMode {
  FREE_PILOT
  PAID_MOCK
  PAID_LIVE
}

enum AuditActorType {
  OPERATOR
  SYSTEM
}

enum AuditTargetType {
  MASTER_PROFILE
  USER
  ORDER
  PLANNED_ORDER
  DISPUTE
}

enum OrderStatus {
  CREATED
  SEARCHING
  ACCEPTED
  MASTER_ON_WAY
  INSPECTION
  AWAITING_PRICE_CONFIRM
  IN_PROGRESS
  DONE
  CLOSED
  NO_MASTERS
  CANCELLED_BY_CLIENT
  CANCELLED_BY_MASTER
  DISPUTE
}

enum OfferOutcome {
  PENDING
  ACCEPTED
  LOST
  EXPIRED
}

enum PaymentType {
  HOLD
  CAPTURE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AccrualType {
  CALLOUT_COMPENSATION
}

enum PlannedOrderStatus {
  CREATED
  PUBLISHED
  MASTER_SELECTED
  CONFIRMED
  IN_PROGRESS
  DONE
  CLOSED
  EXPIRED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_MASTER
  DISPUTE
}

enum LeadCreditTxType {
  PURCHASE
  SPEND
  REFUND
  PENALTY
}

enum WithdrawalStatus {
  PENDING
  PAID
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeTargetRole {
  CLIENT
  MASTER
}

enum CancelledOrderType {
  URGENT
  PLANNED
}
